{
  "framework": null,
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/npm/liz-ai-brasil.tgz",
      "destination": "https://github.com/Panhard-Dev/Liz-Dev-Studio/releases/download/cli-dev/liz-ai-brasil-0.0.0-dev-202605040039.tgz",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/install",
      "destination": "/index.html"
    }
  ]
}
